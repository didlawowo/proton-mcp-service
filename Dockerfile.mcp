# Image du serveur MCP ProtonMail (Python, transport HTTP).
# Wrapper léger au-dessus de l'API HTTP du proton-service Go.
# Base image pinned by multi-arch manifest digest (Dependabot keeps it fresh).
FROM python:3.13-slim@sha256:27b7c9d4f13ca20bb1170148f02095d50a5dfce1f7f2dabf5ca273727e43b7ea

# uv pour une installation des dépendances ~10-20x plus rapide que pip.
COPY --from=ghcr.io/astral-sh/uv:0.12.5@sha256:e85be844203885286c60ffad8a858d48afb6c5a5c237ca0e67f12e74b8f174b1 /uv /uvx /bin/

RUN useradd -u 1000 -m app
WORKDIR /app

RUN uv pip install --no-cache --system \
    "mcp>=1.2,<2" \
    "httpx>=0.27" \
    "uvicorn>=0.30" \
    "starlette>=0.37"

# Security: the base image ships setuptools/msgpack/urllib3 in site-packages
# (residuals not pulled by the deps above) with known HIGH CVEs; keep them
# pinned to fixed versions so the published image scans clean.
RUN uv pip install --no-cache --system --upgrade setuptools msgpack urllib3

COPY mcp_server.py /app/mcp_server.py

USER 1000

ENV MCP_TRANSPORT=http \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=9090

EXPOSE 9090

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import os,urllib.request; urllib.request.urlopen(f\"http://127.0.0.1:{os.environ.get('MCP_PORT','9090')}/healthz\", timeout=3)" || exit 1

CMD ["python", "mcp_server.py"]
