{
    "swagger": "2.0",
    "info": {
        "description": "Micro-service Proton Mail + Calendar (Go + MCP). Envoi d'emails, threading (reply/forward), calendrier chiffré.",
        "title": "Proton Service API",
        "contact": {},
        "version": "1.0.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/addresses": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "messages"
                ],
                "summary": "Lister les adresses du compte",
                "responses": {
                    "200": {
                        "description": "addresses, count",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Initier l'authentification Proton",
                "parameters": [
                    {
                        "description": "Identifiants",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/pkg_api.loginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "authenticated",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "202": {
                        "description": "2fa_required",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "428": {
                        "description": "human verification required",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/calendars": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "calendar"
                ],
                "summary": "Lister les calendriers",
                "responses": {
                    "200": {
                        "description": "calendars, count",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/calendars/{id}/events": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "calendar"
                ],
                "summary": "Lister les événements d'un calendrier",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID du calendrier",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Timestamp Unix (secondes) : ne renvoie que les événements débutant à partir de cette date",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Timestamp Unix (secondes) : ne renvoie que les événements débutant avant cette date",
                        "name": "to",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Fuseau IANA (ex. Europe/Paris) utilisé par Proton pour placer les événements sur la journée entière dans la fenêtre ; défaut UTC",
                        "name": "timezone",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "events, count",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": [],
                        "WriteKey": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "calendar"
                ],
                "summary": "Créer un événement chiffré",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID du calendrier",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Événement (summary, start, end, full_day, description, location)",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_didlawowo_proton-mcp-service_pkg_proton.CreateCalendarEventRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "status: created, event",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/calendars/{id}/events/{eventId}": {
            "delete": {
                "security": [
                    {
                        "ApiKeyAuth": [],
                        "WriteKey": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "calendar"
                ],
                "summary": "Supprimer un événement",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID du calendrier",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "ID de l'événement",
                        "name": "eventId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "status: deleted",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/labels": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "messages"
                ],
                "summary": "Lister les labels et dossiers",
                "responses": {
                    "200": {
                        "description": "labels, count",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/messages/send": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": [],
                        "WriteKey": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "messages"
                ],
                "summary": "Envoyer un email",
                "parameters": [
                    {
                        "description": "Email à envoyer (in_reply_to + action pour répondre/transférer dans le fil)",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/pkg_api.sendRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "status: sent, message_id",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "github_com_didlawowo_proton-mcp-service_pkg_proton.CreateCalendarEventRequest": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "end_time": {
                    "type": "integer"
                },
                "full_day": {
                    "type": "boolean"
                },
                "location": {
                    "type": "string"
                },
                "start_time": {
                    "description": "StartTime/EndTime are unix timestamps.",
                    "type": "integer"
                },
                "summary": {
                    "type": "string"
                },
                "timezone": {
                    "description": "IANA name, optional (UTC if empty)",
                    "type": "string"
                }
            }
        },
        "pkg_api.attachmentReq": {
            "type": "object",
            "properties": {
                "content": {
                    "description": "base64",
                    "type": "string"
                },
                "filename": {
                    "type": "string"
                },
                "mime_type": {
                    "type": "string"
                }
            }
        },
        "pkg_api.loginRequest": {
            "type": "object",
            "properties": {
                "hv_token": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "pkg_api.sendRequest": {
            "type": "object",
            "properties": {
                "action": {
                    "description": "Action : reply | reply_all | forward (ignorée si InReplyTo vide).",
                    "type": "string"
                },
                "attachments": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/pkg_api.attachmentReq"
                    }
                },
                "body": {
                    "type": "string"
                },
                "cc": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "from": {
                    "description": "From : adresse d'envoi optionnelle (adresse active du compte).\nVide = adresse primaire.",
                    "type": "string"
                },
                "html": {
                    "type": "string"
                },
                "in_reply_to": {
                    "description": "InReplyTo : ID interne Proton du message parent (threading reply/forward).",
                    "type": "string"
                },
                "subject": {
                    "type": "string"
                },
                "to": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "security": [
        {"ApiKeyAuth": []}
    ],
    "securityDefinitions": {
        "ApiKeyAuth": {
            "type": "apiKey",
            "name": "X-API-Key",
            "in": "header"
        },
        "WriteKey": {
            "type": "apiKey",
            "name": "X-Write-Key",
            "in": "header"
        }
    }
}